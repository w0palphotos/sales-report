{
  "name": "@mangcoding/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env db/seed.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4"
  }
}
